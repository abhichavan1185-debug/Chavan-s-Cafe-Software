        // Generator to dynamically produce 154 items
        function generateExpandedMenu() {
            const list = [...BASE_DISHES];
            let idGen = 3000;
            const styles = ["Supreme", "Royal", "Crispy", "Tandoori Special", "Chef Choice", "Deluxe"];
            ALL_CATEGORIES.forEach(cat => {
                if (cat === "All") return;
                const match = list.filter(i => i.category === cat);
                let count = match.length;
                while (count < 6) {
                    const seed = match[0] || BASE_DISHES[0];
                    const style = styles[count % styles.length];
                    list.push({
                        id: idGen++,
                        name: `${style} ${seed.name}`,
                        category: cat,
                        price: seed.price + 20,
                        isVeg: seed.isVeg,
                        prep: seed.prep || "12m",
                        image: seed.image,
                        desc: `Signature house preparation of ${seed.name} with aromatic spices.`
                    });
                    count++;
                }
            });
            return list;
        }

