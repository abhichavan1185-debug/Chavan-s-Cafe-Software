                        { id: "SW-8421", platform: "Swiggy", customer: "Ananya Roy", phone: "9819234510", address: "Viman Nagar, Pune", items: [{ name: "Special Irani Chai", qty: 2, price: 25 }], total: 50, status: "Cooking" },
                        { id: "ZM-3910", platform: "Zomato", customer: "Aditya Sawant", phone: "9920145678", address: "Koregaon Park, Pune", items: [{ name: "Classic Cold Coffee", qty: 1, price: 90 }], total: 90, status: "Incoming" }
                    ]));
                }
                if (!localStorage.getItem('chavan_tables')) {
                    localStorage.setItem('chavan_tables', JSON.stringify(Array.from({ length: 15 }, (_, i) => ({
                        id: i + 1, name: `Table ${i + 1}`, status: i === 1 ? 'occupied' : 'available', currentBill: i === 1 ? 260 : 0
                    }))));
                }
            }
            get(k) { return JSON.parse(localStorage.getItem(`chavan_${k}`) || '[]'); }
            set(k, d) { localStorage.setItem(`chavan_${k}`, JSON.stringify(d)); }
        }
        const DB = new StateService();

        const Sound = {
            enabled: true,
            play() {
                if (!this.enabled) return;
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.connect(gain); gain.connect(ctx.destination);
                    osc.frequency.setValueAtTime(523, ctx.currentTime);
                    gain.gain.setValueAtTime(0.2, ctx.currentTime);
                    osc.start(); osc.stop(ctx.currentTime + 0.2);
                } catch(e) {}
            }
        };

        let posCart = [];
        let posCatFilter = 'All';
        let posDietFilter = 'all';

        function initPOS() {
            document.getElementById('pos-category-bar').innerHTML = ALL_CATEGORIES.map(c => `
                <button class="cat-btn ${c === posCatFilter ? 'active' : ''}" onclick="posCatFilter='${c}'; renderPOSCategories(); renderPOSMenu();">${c}</button>
            `).join('');
            renderPOSMenu();
            renderPOSCart();
        }

        function renderPOSCategories() {
            document.querySelectorAll('#pos-category-bar .cat-btn').forEach(btn => {
                btn.classList.toggle('active', btn.innerText === posCatFilter);
            });
        }

        function renderPOSMenu() {
            const q = (document.getElementById('pos-search').value || '').toLowerCase();
            const list = FULL_CATALOG.filter(i => {
                const matchC = posCatFilter === 'All' || i.category === posCatFilter;
                const matchD = posDietFilter === 'all' || (posDietFilter === 'veg' && i.isVeg) || (posDietFilter === 'nonveg' && !i.isVeg);
                const matchQ = i.name.toLowerCase().includes(q) || i.desc.toLowerCase().includes(q);
                return matchC && matchD && matchQ;
            });

            document.getElementById('pos-product-grid').innerHTML = list.map(item => `
                <div class="food-card" onclick="addToPOSCart(${item.id})">
                    <div class="food-card-img-wrap">
                        <img src="${item.image}" alt="${item.name}" onerror="this.onerror=null; this.src='${FALLBACK_CULINARY_IMG}'">
                        <span class="badge-dietary"><span class="diet-icon ${item.isVeg ? 'veg' : 'nonveg'}"></span></span>
                        <span class="badge-prep">${item.prep}</span>
                    </div>
                    <div class="food-card-body">
                        <span class="food-category-tag">${item.category}</span>
                        <h4 class="food-title">${item.name}</h4>
                        <p class="food-desc-short">${item.desc}</p>
                        <div class="food-card-footer">
                            <span class="food-price">₹${item.price}</span>
                            <button class="btn-add-food" onclick="event.stopPropagation(); addToPOSCart(${item.id})">+ Add</button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function addToPOSCart(id) {
            const item = FULL_CATALOG.find(x => x.id === id);
            if (!item) return;
            const exist = posCart.find(x => x.id === id);
            if (exist) exist.qty += 1;
            else posCart.push({ ...item, qty: 1 });
            Sound.play();
            renderPOSCart();
        }

        function renderPOSCart() {
            const list = document.getElementById('pos-cart-tbody');
            list.innerHTML = posCart.map(i => `
                <div class="cart-row">
                    <div>${i.name}</div>
                    <div>
                        <button class="qty-btn" onclick="updateQty(${i.id}, -1)">-</button>
                        <span>${i.qty}</span>
                        <button class="qty-btn" onclick="updateQty(${i.id}, 1)">+</button>
                    </div>
                    <div>₹${i.price}</div>
                    <div>₹${i.price * i.qty}</div>
                    <button onclick="posCart=posCart.filter(x=>x.id!==${i.id}); renderPOSCart();">&times;</button>
                </div>
            `).join('');

            const sub = posCart.reduce((s,i) => s + (i.price * i.qty), 0);
            const tax = sub * 0.05;
            document.getElementById('pos-subtotal').innerText = `₹${sub.toFixed(2)}`;
            document.getElementById('pos-tax').innerText = `₹${tax.toFixed(2)}`;
            document.getElementById('pos-grand-total').innerText = `₹${(sub + tax).toFixed(2)}`;
        }

        function updateQty(id, delta) {
            const item = posCart.find(x => x.id === id);
            if (!item) return;
            item.qty += delta;
            if (item.qty <= 0) posCart = posCart.filter(x => x.id !== id);
            renderPOSCart();
        }

        function executeThermalPrint() { window.print(); }
        function closeBillModal() { document.getElementById('modal-bill-print').classList.remove('open'); }

        // Swiggy & Zomato Dashboards
        function initPartnerDashboards() {
            const orders = DB.get('orders');
            const swiggy = orders.filter(o => o.platform === 'Swiggy');
            const zomato = orders.filter(o => o.platform === 'Zomato');

            document.getElementById('badge-swiggy').innerText = swiggy.filter(o => o.status !== 'Delivered').length;
            document.getElementById('badge-zomato').innerText = zomato.filter(o => o.status !== 'Delivered').length;

            const renderCard = (o) => `
                <div class="order-flow-card">
                    <div><strong>#${o.id}</strong> - ₹${o.total}</div>
                    <div style="font-size:11px; color:#666;">${o.customer}</div>
                    <div style="font-size:10px;">${o.items.map(i => `${i.qty}x ${i.name}`).join(', ')}</div>
                    <div style="display:flex; justify-content:space-between; margin-top:4px;">
                        <span style="font-size:10px; font-weight:700;">${o.status}</span>
                        <button class="btn-order-action accept" onclick="advanceOrderStatus('${o.id}')">Next Stage</button>
                    </div>
                </div>
            `;

            document.getElementById('swiggy-cards-incoming').innerHTML = swiggy.filter(o => o.status === 'Incoming').map(renderCard).join('') || '<div style="font-size:11px; color:#999; padding:10px;">Empty</div>';
            document.getElementById('swiggy-cards-cooking').innerHTML = swiggy.filter(o => o.status === 'Cooking').map(renderCard).join('') || '<div style="font-size:11px; color:#999; padding:10px;">Empty</div>';
            document.getElementById('swiggy-cards-ready').innerHTML = swiggy.filter(o => o.status === 'Ready').map(renderCard).join('') || '<div style="font-size:11px; color:#999; padding:10px;">Empty</div>';
            document.getElementById('swiggy-cards-out').innerHTML = swiggy.filter(o => o.status === 'Delivered').map(renderCard).join('') || '<div style="font-size:11px; color:#999; padding:10px;">Empty</div>';

            document.getElementById('zomato-cards-incoming').innerHTML = zomato.filter(o => o.status === 'Incoming').map(renderCard).join('') || '<div style="font-size:11px; color:#999; padding:10px;">Empty</div>';
            document.getElementById('zomato-cards-cooking').innerHTML = zomato.filter(o => o.status === 'Cooking').map(renderCard).join('') || '<div style="font-size:11px; color:#999; padding:10px;">Empty</div>';
            document.getElementById('zomato-cards-ready').innerHTML = zomato.filter(o => o.status === 'Ready').map(renderCard).join('') || '<div style="font-size:11px; color:#999; padding:10px;">Empty</div>';
            document.getElementById('zomato-cards-out').innerHTML = zomato.filter(o => o.status === 'Delivered').map(renderCard).join('') || '<div style="font-size:11px; color:#999; padding:10px;">Empty</div>';
        }

        function advanceOrderStatus(id) {
            const orders = DB.get('orders');
            const o = orders.find(x => x.id === id);
            if (!o) return;
            if (o.status === 'Incoming') o.status = 'Cooking';
            else if (o.status === 'Cooking') o.status = 'Ready';
            else if (o.status === 'Ready') o.status = 'Delivered';
            DB.set('orders', orders);
            Sound.play();
            initPartnerDashboards();
            refreshStats();
        }

        function triggerSimulatedPartnerOrder(forced) {
            const platform = forced || (Math.random() > 0.5 ? 'Swiggy' : 'Zomato');
            const id = `${platform === 'Swiggy' ? 'SW' : 'ZM'}-${Math.floor(1000 + Math.random() * 9000)}`;
            const dish = FULL_CATALOG[Math.floor(Math.random() * FULL_CATALOG.length)];
            const orders = DB.get('orders');
            orders.unshift({
                id, platform, customer: "Online Diner", phone: "9876543210", address: "Pune Central",
                items: [{ name: dish.name, qty: 1, price: dish.price }], total: dish.price, status: "Incoming"
            });
            DB.set('orders', orders);
            Sound.play();
            showToast(`New ${platform} Order #${id}!`);
            initPartnerDashboards();
            refreshStats();
        }

        // Live Tracking Map Canvas
        function initTrackingMap() {
            const canvas = document.getElementById('delivery-map-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.parentElement.clientWidth || 400;
            canvas.height = canvas.parentElement.clientHeight || 400;
            ctx.fillStyle = "#CBD5E1";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Path
            ctx.strokeStyle = "#F59E0B"; ctx.lineWidth = 4; ctx.beginPath();
            ctx.moveTo(60, canvas.height - 60); ctx.lineTo(canvas.width - 60, 60); ctx.stroke();

            // Icons
            ctx.fillStyle = "#78350F"; ctx.beginPath(); ctx.arc(60, canvas.height - 60, 14, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = "#DC2626"; ctx.beginPath(); ctx.arc(canvas.width - 60, 60, 14, 0, Math.PI*2); ctx.fill();
            ctx.fillStyle = "#16A34A"; ctx.beginPath(); ctx.arc(canvas.width / 2, canvas.height / 2, 16, 0, Math.PI*2); ctx.fill();

            const stages = ["Order Placed", "Accepted", "Cooking", "Partner Assigned", "Out for Delivery", "Delivered"];
            document.getElementById('tracking-10-stepper').innerHTML = stages.map((s, idx) => `
                <div class="stepper-node-row ${idx <= 4 ? 'current' : ''}">
                    <span style="width:18px; height:18px; border-radius:50%; background:#ddd; display:inline-flex; align-items:center; justify-content:center; font-size:10px;">${idx+1}</span>
                    <strong>${s}</strong>
                </div>
            `).join('');
        }

        // Tables Management
        function initTables() {
            const tables = DB.get('tables');
            document.getElementById('tables-grid-container').innerHTML = tables.map(t => `
                <div class="table-card state-${t.status}">
                    <div style="display:flex; justify-content:space-between; font-weight:800;"><span>${t.name}</span><span>${t.status.toUpperCase()}</span></div>
                    <button class="btn-micro" onclick="toggleTable(${t.id})" style="margin-top:auto;">${t.status === 'available' ? 'Mark Occupied' : 'Release'}</button>
                </div>
            `).join('');
        }

        function toggleTable(id) {
            const tables = DB.get('tables');
            const t = tables.find(x => x.id === id);
            if (t) t.status = t.status === 'available' ? 'occupied' : 'available';
            DB.set('tables', tables);
            initTables();
            refreshStats();
        }

        function vacateAllTables() {
            const tables = DB.get('tables');
            tables.forEach(t => t.status = 'available');
            DB.set('tables', tables);
            initTables();
            refreshStats();
            showToast("All tables vacated");
        }

        // Analytics
        function initAnalytics() {
            const orders = DB.get('orders');
            const gross = orders.reduce((s,o) => s + o.total, 0);
            document.getElementById('kpi-gross-rev').innerText = `₹${gross.toFixed(2)}`;
            document.getElementById('kpi-total-orders').innerText = orders.length;

            const c1 = document.getElementById('chart-sales-trend');
            if (c1) {
                const ctx = c1.getContext('2d');
                c1.width = 400; c1.height = 180;
                ctx.strokeStyle = '#F59E0B'; ctx.lineWidth = 3; ctx.beginPath();
                ctx.moveTo(10, 160); ctx.lineTo(150, 80); ctx.lineTo(380, 20); ctx.stroke();
            }

            const c2 = document.getElementById('chart-channel-share');
            if (c2) {
                const ctx = c2.getContext('2d');
                c2.width = 180; c2.height = 180;
                ctx.beginPath(); ctx.arc(90, 90, 70, 0, Math.PI * 1.2); ctx.lineTo(90,90); ctx.fillStyle = '#78350F'; ctx.fill();
                ctx.beginPath(); ctx.arc(90, 90, 70, Math.PI * 1.2, Math.PI * 2); ctx.lineTo(90,90); ctx.fillStyle = '#FC8019'; ctx.fill();
            }
        }

        // Inventory, CRM & Menu
        function initOtherViews() {
            document.getElementById('inventory-table-body').innerHTML = `
                <tr><td>Arabica Coffee Beans</td><td>18.5 kg</td><td><span class="stock-status-pill good">Optimal</span></td><td><button class="btn-micro">+5 kg</button></td></tr>
                <tr><td>Full Cream Milk</td><td>45.0 L</td><td><span class="stock-status-pill good">Optimal</span></td><td><button class="btn-micro">+5 L</button></td></tr>
            `;
            document.getElementById('crm-table-body').innerHTML = `
                <tr><td>Rahul Deshmukh</td><td>9822012345</td><td>14</td><td><span class="stock-status-pill good">Gold VIP</span></td></tr>
                <tr><td>Pooja Kulkarni</td><td>9890123456</td><td>8</td><td><span class="stock-status-pill good">Silver</span></td></tr>
            `;
            document.getElementById('admin-menu-table-body').innerHTML = FULL_CATALOG.slice(0, 12).map(i => `
                <tr><td><strong>${i.name}</strong></td><td>${i.category}</td><td>₹${i.price}</td><td><span class="stock-status-pill good">Available</span></td></tr>
            `).join('');
            document.getElementById('fleet-cards-grid').innerHTML = `
                <div class="table-card"><strong>Ramesh Shinde</strong><div>Bajaj Pulsar (MH 12 AB 1234)</div><span class="stock-status-pill good">On Delivery</span></div>
                <div class="table-card"><strong>Sachin Kadam</strong><div>Honda Activa (MH 12 CD 5678)</div><span class="stock-status-pill good">Available</span></div>
            `;
        }

        function showToast(msg) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerText = msg;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 2500);
        }

        function refreshStats() {
            const orders = DB.get('orders');
            const gross = orders.reduce((s,o) => s + o.total, 0);
            document.getElementById('hdr-today-sales').innerText = `₹${gross.toFixed(2)}`;
            document.getElementById('hdr-order-count').innerText = orders.length;
            const tables = DB.get('tables');
            document.getElementById('hdr-table-occupancy').innerText = `${tables.filter(t => t.status !== 'available').length}/15`;
        }

        function switchView(id) {
            document.querySelectorAll('.app-view').forEach(v => v.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
            document.getElementById(`view-${id}`)?.classList.add('active');
            document.querySelector(`.nav-item[data-view="${id}"]`)?.classList.add('active');

            if (id === 'pos') renderPOSMenu();
            if (id === 'swiggy' || id === 'zomato') initPartnerDashboards();
            if (id === 'tracking') initTrackingMap();
            if (id === 'tables') initTables();
            if (id === 'analytics') initAnalytics();
        }

        // DOM BOOTSTRAP
        document.addEventListener('DOMContentLoaded', () => {
            setInterval(() => {
                document.getElementById('live-clock').innerText = new Date().toLocaleTimeString('en-IN', { hour12: true });
            }, 1000);

            document.querySelectorAll('.nav-item').forEach(btn => {
                btn.addEventListener('click', () => switchView(btn.dataset.view));
            });

            document.querySelectorAll('.diet-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.diet-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    posDietFilter = btn.dataset.diet;
                    renderPOSMenu();
                });
            });

            document.getElementById('pos-search').addEventListener('input', renderPOSMenu);
            document.getElementById('btn-sound-toggle').addEventListener('click', () => {
                Sound.enabled = !Sound.enabled;
                showToast(Sound.enabled ? "Sound ON" : "Sound Muted");
            });
            document.getElementById('btn-simulate-order').addEventListener('click', () => triggerSimulatedPartnerOrder());

            document.getElementById('btn-pos-clear').addEventListener('click', () => { posCart = []; renderPOSCart(); });
            document.getElementById('btn-pos-kot').addEventListener('click', () => {
                if (posCart.length === 0) return showToast("Cart is empty");
                showToast("KOT Sent to Kitchen");
            });
            document.getElementById('btn-pos-bill-print').addEventListener('click', () => {
                if (posCart.length === 0) return showToast("Cart is empty");
                const sub = posCart.reduce((s,i) => s + (i.price * i.qty), 0);
                const grand = sub * 1.05;
                document.getElementById('rec-grand-total').innerText = `₹${grand.toFixed(2)}`;
                document.getElementById('rec-items-tbody').innerHTML = posCart.map(i => `<tr><td>${i.name}</td><td style="text-align:center;">${i.qty}</td><td style="text-align:right;">${i.price*i.qty}</td></tr>`).join('');
                document.getElementById('modal-bill-print').classList.add('open');
                posCart = []; renderPOSCart();
            });

            initPOS();
            initPartnerDashboards();
            initTables();
            initOtherViews();
            refreshStats();
        });
    </script>
</body>
</html>
